OTHER_LDFLAGS = $(inherited) -Wl,-export_dynamic -Wl,-u,_measurement_engine_create -Wl,-u,_measurement_engine_destroy -Wl,-u,_measurement_optimize -Wl,-u,_measurement_result_release
